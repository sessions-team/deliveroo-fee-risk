# Deliveroo Fee Risk Analysis — environment. Real .env lives ONLY on the VM
# (/opt/deliveroo-fee-risk/.env, chmod 600). No .env at all = local dev mode:
# auth OFF, server open on 127.0.0.1 only.

# --- server ---
PORT=8085                                       # VM port (local default 4700)
APP_BASE_URL=http://feerisk.34.13.22.38.nip.io  # public origin; OAuth redirect = <this>/auth/callback
PORTAL_URL=http://portal.34.13.22.38.nip.io/

# --- Google OAuth (client "Sessions Deliveroo Fee Risk Analysis" in sessions-core-data) ---
# Setting GOOGLE_CLIENT_ID is what turns auth ON.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=          # long random string; signs the 30-day session cookie

# --- pipeline inputs ---
# Platform-weekly-dashboard checkout: provides scripts/weeks.js (statement discovery).
# VM: /opt/weekly-platform-kpi   Local default: C:/Users/Trist/Documents/Claude/projects/Platform-weekly-dashboard
PLATFORM_KPI_DIR=/opt/weekly-platform-kpi
# Finance-drive root the statements are read from.
# VM: the weekly-platform-kpi rclone mirror. Local: leave unset (Google Drive for Desktop auto-resolved).
SESSIONS_FINANCE_DRIVE=/opt/weekly-platform-kpi/drive-mirror

# --- BigQuery (read-only; VM uses the attached service account via ADC — no key file) ---
BQ_PROJECT_ID=sessions-core-data
BQ_LOCATION=europe-west2
# Local dev only, if user ADC is unavailable:
# BIGQUERY_KEY_FILE=/absolute/path/to/service-account.json
